<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyDayQuest.Avalonia.ViewModels"
        x:Class="MyDayQuest.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="400" MinWidth="400" MaxWidth="400"
        Height="730"
        Title="My Day Quest"
        Icon="/Assets/questmark.png"
        FontFamily="Georgia, Times New Roman, serif"
        Background="#15100A">

    <Window.Styles>
        <Style Selector="Button.header">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#F2D48A" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="#D8A22A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#48381F" Offset="0" />
                        <GradientStop Color="#221A0E" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.header /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.header:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33D8A22A" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="BorderBrush" Value="#D8A22A" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#4A3920" Offset="0" />
                        <GradientStop Color="#1E170D" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33D8A22A" />
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="#EBDCB8" />
            <Setter Property="BorderBrush" Value="#C9AE7B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Image Grid.Row="0" Grid.RowSpan="4" Source="/Assets/leatherbg.png" Stretch="UniformToFill" />

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Margin="10,8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="&#x25C6;" Foreground="#D8A22A" FontSize="11" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="M &#xB7; D &#xB7; Q" Foreground="#F2D48A" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Text="&#x25C6;" Foreground="#D8A22A" FontSize="11" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
            <Image Grid.Row="0" Source="/Assets/update.png" Width="34" Height="34"
                   HorizontalAlignment="Left" IsVisible="{Binding IsUpdateAvailable}"
                   PointerPressed="OnUpdateClick" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Classes="header" Content="Save" Background="#DCE0F7" Click="OnSave" />
                <Button Grid.Column="1" Classes="header" Content="Load" Background="#FBE2D5" Click="OnLoad" />
                <Button Grid.Column="2" Classes="header" Content="Sync" Background="#FBF3D0" Click="OnSync" />
                <Button Grid.Column="3" Classes="header" Content="About" Background="#DDEFD9" Click="OnAbout" />
            </Grid>
            <!-- Облако: подключение и состояние автосинхронизации -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="header" Content="Cloud" Background="#D5ECF7"
                        Width="86" Click="OnCloud" />
                <TextBlock Grid.Column="1" Text="{Binding CloudStatus}"
                           Foreground="#F2D48A" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>

            <Rectangle Grid.Row="3" Height="1" Fill="#D8A22A" Opacity="0.85" />
        </Grid>

        <!-- СРЕДНЕЕ ПОЛЕ -->
        <Grid Grid.Row="1" Margin="16,12">
            <!-- Главное окно: дневной план -->
            <ScrollViewer IsVisible="{Binding IsHomeVisible}">
                <StackPanel>
                    <TextBlock Text="Журнал заданий пуст. Отметьте задание в листе — и оно появится здесь."
                               Foreground="#F2D48A" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="8,40" IsVisible="{Binding DailyItems.Count, Converter={x:Static vm:Conv.IsZero}}" />
                    <ItemsControl ItemsSource="{Binding DailyItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DailyCardVM">
                                <Border BorderBrush="#D8A22A" BorderThickness="2" CornerRadius="5"
                                        Background="#EBDCB8" Padding="10" Margin="0,0,0,12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding ListLine}" Foreground="#6B5537" FontSize="11" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="/Assets/questmark.png" Width="34" Height="34" />
                                            <TextBlock Grid.Column="1" Text="{Binding NameLine}" Foreground="#2A1F12"
                                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                        </Grid>
                                        <Rectangle Height="1" Fill="#C9AE7B" />
                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasCurrentSubtask}">
                                            <CheckBox Grid.Column="0" IsChecked="False" IsCheckedChanged="OnDailySubtaskChecked" Tag="{Binding}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentSubtaskText}" Foreground="#2A1F12" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DateRange}" Foreground="#6B5537" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#6B5537" FontWeight="Bold" FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Открытый лист: задания -->
            <ScrollViewer IsVisible="{Binding IsListOpen}">
                <ItemsControl ItemsSource="{Binding CurrentTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskCardVM">
                            <Border BorderThickness="2" CornerRadius="5" Background="#EBDCB8" Padding="10" Margin="0,0,0,12"
                                    BorderBrush="{Binding IsSelected, Converter={x:Static vm:Conv.SelBrush}}"
                                    Tapped="OnTaskTapped" DoubleTapped="OnTaskDoubleTapped" Tag="{Binding}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Image Grid.Column="0" Source="/Assets/questmark.png" Width="34" Height="34" />
                                        <TextBlock Grid.Column="1" Text="{Binding NameLine}" Foreground="#2A1F12"
                                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding InDailyPlan, Mode=TwoWay}"
                                                  IsCheckedChanged="OnPlanChecked" Tag="{Binding}" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#C9AE7B" />
                                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasCurrentSubtask}">
                                        <CheckBox Grid.Column="0" IsChecked="False" IsCheckedChanged="OnTaskSubtaskChecked" Tag="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentSubtaskText}" Foreground="#2A1F12" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding DateRange}" Foreground="#6B5537" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#6B5537" FontWeight="Bold" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ + / QUEST / - -->
        <Grid Grid.Row="2" Margin="16,4" ColumnDefinitions="Auto,*,Auto,*,Auto">
            <Button Grid.Column="0" Classes="action" Content="+" Foreground="#5FB13A" Command="{Binding AddCommand}" />
            <Button Grid.Column="2" Classes="action" Content="QUEST" FontSize="17" Foreground="#F2D48A" Width="110" Command="{Binding GoHomeCommand}" />
            <Button Grid.Column="4" Classes="action" Content="–" Foreground="#C0392B" Command="{Binding RemoveCommand}" />
        </Grid>

        <!-- ЛЕНТА ВКЛАДОК -->
        <Border Grid.Row="3" Background="#1E1710" Height="96" BorderBrush="#D8A22A" BorderThickness="0,1,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="20,12">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestTabVM">
                            <Button Classes="tab" Width="120" Height="60" Margin="-14,0,0,0" Padding="8"
                                    Background="{Binding ColorHex}"
                                    Command="{Binding ((vm:MainViewModel)DataContext).OpenTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Name}" Foreground="#2A1F12" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
