<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Скин «игровой»: журнал заданий — тёмная кожа, пергамент и золото.
  Набор ключей здесь и в SkinClassic.xaml обязан совпадать: словари
  подменяются целиком на ходу, и недостающий ключ уронит разметку.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="MyDayQuest.Resources.Styles.SkinQuest">

    <!-- ==== Цвета ==== -->
    <Color x:Key="Leather">#15100A</Color>          <!-- фон окна -->
    <Color x:Key="LeatherPanel">#1E1710</Color>     <!-- нижняя панель вкладок -->
    <Color x:Key="LeatherButton">#3A2C18</Color>    <!-- кнопки -->
    <Color x:Key="Parchment">#EBDCB8</Color>        <!-- плашки заданий -->
    <Color x:Key="ParchmentEdge">#C9AE7B</Color>    <!-- край пергамента -->
    <Color x:Key="QuestGold">#D8A22A</Color>        <!-- рамки, акценты -->
    <Color x:Key="QuestGoldBright">#F2D48A</Color>  <!-- текст на тёмном -->
    <Color x:Key="QuestGoldDim">#6E5320</Color>     <!-- разделители -->
    <Color x:Key="QuestInk">#2A1F12</Color>         <!-- текст на пергаменте -->
    <Color x:Key="QuestInkSoft">#6B5537</Color>     <!-- вторичный текст -->
    <Color x:Key="QuestGreen">#5FB13A</Color>
    <Color x:Key="QuestRed">#C0392B</Color>
    <Color x:Key="QuestSelect">#2E6FD6</Color>      <!-- выбранное на светлом -->
    <Color x:Key="QuestSelectBright">#5B9BFF</Color><!-- выбранное на тёмном -->

    <Color x:Key="ActionButtonText">#F2D48A</Color>

    <!-- ==== Шрифт ==== -->
    <!-- Серифный берём системный: на каждой платформе он называется по-своему. -->
    <OnPlatform x:Key="SerifFont" x:TypeArguments="x:String">
        <On Platform="WinUI" Value="Georgia" />
        <On Platform="iOS, MacCatalyst" Value="Georgia" />
        <On Platform="Android" Value="serif" />
    </OnPlatform>

    <!-- ==== Заливки ==== -->
    <!-- Плашка задания: пергамент с мягким свечением к центру. -->
    <RadialGradientBrush x:Key="CardBrush" Center="0.5,0.4" Radius="0.85">
        <GradientStop Color="#F6EBD0" Offset="0.0" />
        <GradientStop Color="#E7D6AE" Offset="0.6" />
        <GradientStop Color="#D3BB8C" Offset="1.0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HeaderButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#48381F" Offset="0" />
        <GradientStop Color="#221A0E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActionButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A3920" Offset="0" />
        <GradientStop Color="#1E170D" Offset="1" />
    </LinearGradientBrush>

    <!-- ==== Стили кнопок ==== -->
    <Style x:Key="HoverButton" TargetType="Button">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.04" />
                            <Setter Property="BorderColor" Value="{DynamicResource QuestGoldBright}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.96" />
                            <Setter Property="Opacity" Value="0.85" />
                            <Setter Property="BorderColor" Value="{DynamicResource QuestSelectBright}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource HoverButton}">
        <Setter Property="TextColor" Value="{DynamicResource QuestGoldBright}" />
        <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource QuestGold}" />
        <Setter Property="Background" Value="{DynamicResource HeaderButtonBrush}" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource HoverButton}">
        <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="BorderColor" Value="{DynamicResource QuestGold}" />
        <Setter Property="Background" Value="{DynamicResource ActionButtonBrush}" />
    </Style>

</ResourceDictionary>
