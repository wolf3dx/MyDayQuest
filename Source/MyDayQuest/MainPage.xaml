<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyDayQuest.ViewModels"
             x:Class="MyDayQuest.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{DynamicResource Leather}">

        <!-- Тёмная кожа обложки под всем содержимым -->
        <Image Grid.Row="0" Grid.RowSpan="3" Source="leatherbg.png" Aspect="AspectFill"
               IsVisible="{Binding IsQuestSkin}"
               WidthRequest="1" HeightRequest="1"
               HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- ============ ВЕРХ: заголовок журнала и кнопки ============ -->
        <Grid Grid.Row="0" Padding="12,10,12,0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">

            <!-- Название с ромбами-разделителями -->
            <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="10">
                <Label Text="◆" TextColor="{DynamicResource QuestGold}" FontSize="11"
                       VerticalOptions="Center" Opacity="0.8" />
                <Label Text="M · D · Q"
                       FontFamily="{DynamicResource SerifFont}"
                       TextColor="{DynamicResource QuestGoldBright}"
                       CharacterSpacing="2" FontSize="22" FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Label Text="◆" TextColor="{DynamicResource QuestGold}" FontSize="11"
                       VerticalOptions="Center" Opacity="0.8" />
            </HorizontalStackLayout>

            <Label Grid.Row="1" Text="ЖУРНАЛ ЗАДАНИЙ"
                   FontFamily="{DynamicResource SerifFont}"
                   TextColor="{DynamicResource QuestGold}" Opacity="0.75"
                   CharacterSpacing="5" FontSize="10"
                   HorizontalOptions="Center" />

            <!-- Иконка обновления (появляется, когда есть новая версия) -->
            <ImageButton Grid.Row="0"
                         Source="update.png"
                         IsVisible="{Binding IsUpdateAvailable}"
                         Command="{Binding UpdateAppCommand}"
                         HorizontalOptions="Start" VerticalOptions="Center"
                         WidthRequest="34" HeightRequest="34"
                         BackgroundColor="Transparent" />

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,4,0,0">
                <Button Grid.Column="0" Text="Save"
                        Style="{DynamicResource HeaderButton}"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="1" Text="Load"
                        Style="{DynamicResource HeaderButton}"
                        Command="{Binding LoadFromFileCommand}" />
                <Button Grid.Column="2" Text="Sync"
                        Style="{DynamicResource HeaderButton}"
                        Command="{Binding SyncCommand}" />
                <Button Grid.Column="3" Text="About"
                        Style="{DynamicResource HeaderButton}"
                        Clicked="OnAboutClicked" />
            </Grid>

            <!-- Золотая линия под шапкой -->
            <Grid Grid.Row="3" Margin="0,6,0,0" HeightRequest="3">
                <BoxView HeightRequest="1" Color="{DynamicResource QuestGold}"
                         Opacity="0.85" VerticalOptions="Start" />
                <BoxView HeightRequest="1" Color="{DynamicResource QuestGoldDim}"
                         VerticalOptions="End" />
            </Grid>
        </Grid>

        <!-- ============ СРЕДНЕЕ ПОЛЕ ============ -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Padding="14,12">

            <!-- Главное окно: задания дневного плана (когда лист не открыт) -->
            <CollectionView Grid.Row="0"
                            IsVisible="{Binding IsEmptyFieldVisible}"
                            ItemsSource="{Binding DailyItems}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Spacing="10" Padding="16,24">
                        <Label Text="!" TextColor="{DynamicResource QuestGold}" Opacity="0.35"
                               FontFamily="{DynamicResource SerifFont}"
                               FontSize="52" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Журнал заданий пуст"
                               FontFamily="{DynamicResource SerifFont}"
                               TextColor="{DynamicResource QuestGoldBright}" Opacity="0.65"
                               FontSize="15" HorizontalOptions="Center" />
                        <Label Text="Отметьте задание в листе — и оно появится здесь."
                               FontFamily="{DynamicResource SerifFont}"
                               TextColor="{DynamicResource QuestGoldBright}" Opacity="0.4"
                               FontSize="12" HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DailyTaskVM">
                        <!-- Свиток: золотая рамка, внутри пергамент.
                             Задание, не сделанное в свой день, краснеет. -->
                        <Border StrokeShape="RoundRectangle 5" StrokeThickness="2"
                                Stroke="{DynamicResource QuestGold}"
                                Background="{DynamicResource CardBrush}"
                                Padding="0" Margin="0,0,0,12">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource QuestRed}" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                    </DataTrigger>
                                </Border.Triggers>
                            <Grid>
                                <Border StrokeShape="RoundRectangle 3" StrokeThickness="1"
                                        Stroke="{DynamicResource QuestGoldDim}"
                                        BackgroundColor="Transparent"
                                        Margin="4" Padding="12,10">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="Auto,*"
                                          RowSpacing="8" ColumnSpacing="10">

                                        <!-- Лист-источник, а для просроченного — с какого дня висит -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ListLine}"
                                               FontFamily="{DynamicResource SerifFont}"
                                               TextColor="{DynamicResource QuestInkSoft}"
                                               CharacterSpacing="1" FontSize="11" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding OverdueText}"
                                               IsVisible="{Binding IsOverdue}"
                                               FontFamily="{DynamicResource SerifFont}"
                                               TextColor="{DynamicResource QuestRed}"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1" FontSize="11"
                                               HorizontalTextAlignment="End" />

                                        <!-- Медальон «!» и название задания -->
                                        <Image Grid.Row="1" Grid.Column="0" Source="questmark.png"
                                               WidthRequest="34" HeightRequest="34" VerticalOptions="Start" />
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding NameLine}"
                                               FontFamily="{DynamicResource SerifFont}"
                                               TextColor="{DynamicResource QuestInk}"
                                               FontAttributes="Bold" FontSize="16"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource QuestRed}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- Разделитель -->
                                        <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                 HeightRequest="1" Color="{DynamicResource ParchmentEdge}" />

                                        <!-- Текущая цель -->
                                        <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="False"
                                                  Color="{DynamicResource QuestInk}"
                                                  VerticalOptions="Center"
                                                  IsVisible="{Binding HasCurrentSubtask}"
                                                  CheckedChanged="OnDailySubtaskChecked" />
                                        <Label Grid.Row="3" Grid.Column="1"
                                               Text="{Binding CurrentSubtaskText}"
                                               FontFamily="{DynamicResource SerifFont}"
                                               TextColor="{DynamicResource QuestInk}"
                                               FontSize="14" VerticalOptions="Center"
                                               IsVisible="{Binding HasCurrentSubtask}" />

                                        <!-- Сроки и полоса прогресса -->
                                        <VerticalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                             Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding DateRange}"
                                                       FontFamily="{DynamicResource SerifFont}"
                                                       TextColor="{DynamicResource QuestInkSoft}"
                                                       FontSize="11" />
                                                <Label Grid.Column="1" Text="{Binding ProgressText}"
                                                       FontFamily="{DynamicResource SerifFont}"
                                                       TextColor="{DynamicResource QuestInkSoft}"
                                                       FontSize="11" FontAttributes="Bold" />
                                            </Grid>
                                            <Border StrokeShape="RoundRectangle 2" StrokeThickness="1"
                                                    Stroke="{DynamicResource ParchmentEdge}"
                                                    BackgroundColor="#33000000"
                                                    HeightRequest="8" Padding="0">
                                                <ProgressBar
                                                    Progress="{Binding Progress, Converter={StaticResource PercentToFraction}}"
                                                    ProgressColor="{DynamicResource QuestGold}"
                                                    BackgroundColor="Transparent"
                                                    VerticalOptions="Fill" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Открытый лист: задания этого листа -->
            <Grid Grid.Row="0" IsVisible="{Binding IsListOpen}">
                <CollectionView ItemsSource="{Binding CurrentTasks}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskItemVM">
                            <Border StrokeShape="RoundRectangle 5" StrokeThickness="2"
                                    Background="{DynamicResource CardBrush}"
                                    Padding="0" Margin="0,0,0,12">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource QuestSelect}" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Stroke" Value="{DynamicResource QuestGold}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=SelectTaskCommand}"
                                        CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenTaskCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid>
                                    <Border StrokeShape="RoundRectangle 3" StrokeThickness="1"
                                            Stroke="{DynamicResource QuestGoldDim}"
                                            BackgroundColor="Transparent"
                                            Margin="4" Padding="12,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                              ColumnDefinitions="Auto,*"
                                              RowSpacing="8" ColumnSpacing="10">

                                            <!-- Медальон «!», название и чек-бокс «взять на сегодня» -->
                                            <Image Grid.Row="0" Grid.Column="0" Source="questmark.png"
                                                   WidthRequest="34" HeightRequest="34" VerticalOptions="Start" />
                                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding NameLine}"
                                                       FontFamily="{DynamicResource SerifFont}"
                                                       TextColor="{DynamicResource QuestInk}"
                                                       FontAttributes="Bold" FontSize="16"
                                                       VerticalOptions="Center" />
                                                <CheckBox Grid.Column="1"
                                                          Color="{DynamicResource QuestInk}"
                                                          VerticalOptions="Center"
                                                          IsChecked="{Binding InDailyPlan}"
                                                          CheckedChanged="OnPlanChecked" />
                                            </Grid>

                                            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                     HeightRequest="1" Color="{DynamicResource ParchmentEdge}" />

                                            <!-- Текущая цель -->
                                            <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="False"
                                                      Color="{DynamicResource QuestInk}"
                                                      VerticalOptions="Center"
                                                      IsVisible="{Binding HasCurrentSubtask}"
                                                      CheckedChanged="OnCurrentSubtaskChecked" />
                                            <Label Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding CurrentSubtaskText}"
                                                   FontFamily="{DynamicResource SerifFont}"
                                                   TextColor="{DynamicResource QuestInk}"
                                                   FontSize="14" VerticalOptions="Center"
                                                   IsVisible="{Binding HasCurrentSubtask}" />

                                            <!-- Сроки и полоса прогресса -->
                                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                                 Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0" Text="{Binding DateRange}"
                                                           FontFamily="{DynamicResource SerifFont}"
                                                           TextColor="{DynamicResource QuestInkSoft}"
                                                           FontSize="11" />
                                                    <Label Grid.Column="1" Text="{Binding ProgressText}"
                                                           FontFamily="{DynamicResource SerifFont}"
                                                           TextColor="{DynamicResource QuestInkSoft}"
                                                           FontSize="11" FontAttributes="Bold" />
                                                </Grid>
                                                <Border StrokeShape="RoundRectangle 2" StrokeThickness="1"
                                                        Stroke="{DynamicResource ParchmentEdge}"
                                                        BackgroundColor="#33000000"
                                                        HeightRequest="8" Padding="0">
                                                    <ProgressBar
                                                        Progress="{Binding Progress, Converter={StaticResource PercentToFraction}}"
                                                        ProgressColor="{DynamicResource QuestGold}"
                                                        BackgroundColor="Transparent"
                                                        VerticalOptions="Fill" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Кнопки + / QUEST / – внизу среднего поля -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Style="{DynamicResource ActionButton}"
                        Text="+" FontSize="30" FontAttributes="Bold"
                        TextColor="{DynamicResource QuestGreen}"
                        WidthRequest="74"
                        Command="{Binding AddCommand}" />
                <Button Grid.Column="2"
                        Style="{DynamicResource ActionButton}"
                        Text="QUEST" FontSize="17" FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="{DynamicResource ActionButtonText}"
                        Padding="14,0"
                        Command="{Binding GoHomeCommand}" />
                <Button Grid.Column="4"
                        Style="{DynamicResource ActionButton}"
                        Text="–" FontSize="30" FontAttributes="Bold"
                        TextColor="{DynamicResource QuestRed}"
                        WidthRequest="74"
                        Command="{Binding RemoveCommand}" />
            </Grid>
        </Grid>

        <!-- ============ НИЖНИЙ БЛОК: закладки листов ============ -->
        <Grid Grid.Row="2" HeightRequest="106">
            <BoxView HeightRequest="1" Color="{DynamicResource QuestGold}"
                     Opacity="0.7" VerticalOptions="Start" />
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Always"
                        Padding="20,14">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tabs}"
                                       Spacing="10" VerticalOptions="Fill">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestTab">
                            <!-- Овал: радиус в половину высоты плашки. Закладки больше не
                                 наезжают друг на друга — у овалов нахлёст читается как брак,
                                 да и у самой левой половина рамки уходила за край экрана. -->
                            <Border StrokeShape="RoundRectangle 39"
                                    StrokeThickness="1" Stroke="{DynamicResource QuestGoldDim}"
                                    WidthRequest="132"
                                    BackgroundColor="{DynamicResource Parchment}"
                                    Padding="0">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TranslationY" Value="-8" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                        <Setter Property="Stroke" Value="{DynamicResource QuestSelect}" />
                                    </DataTrigger>
                                    <!-- Закладка, на место которой сейчас метят. Идёт после
                                         выделения: при совпадении побеждает последний признак. -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter Property="StrokeThickness" Value="3" />
                                        <Setter Property="Stroke" Value="{DynamicResource QuestGreen}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenTabCommand}"
                                        CommandParameter="{Binding .}" />
                                    <!-- Долгое нажатие берёт закладку, отпускание на соседней
                                         меняет их местами. -->
                                    <DragGestureRecognizer
                                        DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=BeginTabDragCommand}"
                                        DragStartingCommandParameter="{Binding .}" />
                                    <DropGestureRecognizer AllowDrop="True"
                                        DragOverCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TabDragOverCommand}"
                                        DragOverCommandParameter="{Binding .}"
                                        DragLeaveCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TabDragLeaveCommand}"
                                        DragLeaveCommandParameter="{Binding .}"
                                        DropCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DropTabCommand}"
                                        DropCommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Fill + выравнивание по центру: иначе на Android длинное
                                         название не обрезается, а вылезает за края закладки. -->
                                    <Label Text="{Binding ShortName}"
                                           FontFamily="{DynamicResource SerifFont}"
                                           TextColor="{DynamicResource QuestInk}"
                                           FontSize="12" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           Margin="16,0"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
