<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyDayQuest.ViewModels"
             x:Class="MyDayQuest.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Реакция кнопок на наведение (PointerOver) и нажатие (Pressed) -->
        <Style x:Key="HoverButton" TargetType="Button">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.06" />
                                <Setter Property="Opacity" Value="0.9" />
                                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource HoverButton}">
            <Setter Property="TextColor" Value="#222222" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="#40000000" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ВЕРХ: M.D.Q по центру + кнопки Save/Load/Sync/About -->
        <Grid Grid.Row="0" Padding="10,8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <Label Grid.Row="0" Text="M.D.Q"
                   FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <!-- Иконка обновления (появляется, когда есть новая версия) -->
            <ImageButton Grid.Row="0"
                         Source="update.png"
                         IsVisible="{Binding IsUpdateAvailable}"
                         Command="{Binding UpdateAppCommand}"
                         HorizontalOptions="Start" VerticalOptions="Center"
                         WidthRequest="38" HeightRequest="38"
                         BackgroundColor="Transparent" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Text="Save"
                        Style="{StaticResource HeaderButton}" BackgroundColor="#DCE0F7"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="1" Text="Load"
                        Style="{StaticResource HeaderButton}" BackgroundColor="#FBE2D5"
                        Command="{Binding LoadFromFileCommand}" />
                <Button Grid.Column="2" Text="Sync"
                        Style="{StaticResource HeaderButton}" BackgroundColor="#FBF3D0"
                        Command="{Binding SyncCommand}" />
                <Button Grid.Column="3" Text="About"
                        Style="{StaticResource HeaderButton}" BackgroundColor="#DDEFD9"
                        Clicked="OnAboutClicked" />
            </Grid>

            <BoxView Grid.Row="2" HeightRequest="1" Color="#30000000" />
        </Grid>

        <!-- СРЕДНЕЕ ПОЛЕ -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Padding="16,12">

            <!-- Главное окно: плашки заданий дневного плана (когда лист не открыт) -->
            <CollectionView Grid.Row="0"
                            IsVisible="{Binding IsEmptyFieldVisible}"
                            ItemsSource="{Binding DailyItems}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Spacing="6" Padding="8,24">
                        <Label Text="Отметьте чек-бокс у названия задания в листе,&#10;чтобы оно появилось здесь."
                               HorizontalOptions="Fill" HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" Opacity="0.45" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DailyTaskVM">
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="2" Stroke="#50000000"
                                Padding="12" Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                  RowSpacing="12" ColumnSpacing="10">
                                <!-- имя листа-источника -->
                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding ListLine}"
                                       FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                                <!-- пилюля Name (без чек-бокса) -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        StrokeShape="RoundRectangle 22" StrokeThickness="1.5" Stroke="#50000000"
                                        Padding="14,8">
                                    <Label Text="{Binding NameLine}"
                                           FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" />
                                </Border>
                                <!-- текущее подзадание с чек-боксом -->
                                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="False"
                                          VerticalOptions="Center"
                                          IsVisible="{Binding HasCurrentSubtask}"
                                          CheckedChanged="OnDailySubtaskChecked" />
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CurrentSubtaskText}"
                                       FontSize="14" VerticalOptions="Center"
                                       IsVisible="{Binding HasCurrentSubtask}" />
                                <!-- даты + прогресс -->
                                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding DateRange}"
                                           FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ProgressText}"
                                           FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Открытый лист: только задания этого листа -->
            <Grid Grid.Row="0" IsVisible="{Binding IsListOpen}">
                <CollectionView ItemsSource="{Binding CurrentTasks}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskItemVM">
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="2"
                                    Padding="12" Margin="0,0,0,10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Stroke" Value="#50000000" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=SelectTaskCommand}"
                                        CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenTaskCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <!-- Единая сетка: левая колонка чек-боксов + контент -->
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="Auto,*"
                                      RowSpacing="12" ColumnSpacing="10">

                                    <!-- Пилюля с названием: чек-бокс ВНУТРИ овала слева + Name по центру -->
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                            StrokeShape="RoundRectangle 22"
                                            StrokeThickness="1.5" Stroke="#50000000"
                                            Padding="10,6">
                                        <Grid>
                                            <Label Text="{Binding NameLine}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <CheckBox HorizontalOptions="Start" VerticalOptions="Center"
                                                      IsChecked="{Binding InDailyPlan}"
                                                      CheckedChanged="OnPlanChecked" />
                                        </Grid>
                                    </Border>

                                    <!-- Чек-бокс текущего подзадания (в той же левой колонке) -->
                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="False"
                                              VerticalOptions="Center"
                                              IsVisible="{Binding HasCurrentSubtask}"
                                              CheckedChanged="OnCurrentSubtaskChecked" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding CurrentSubtaskText}"
                                           FontSize="14" VerticalOptions="Center"
                                           IsVisible="{Binding HasCurrentSubtask}" />

                                    <!-- Нижняя строка (от левого края): даты слева, прогресс справа -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                          ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding DateRange}"
                                               FontSize="12" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding ProgressText}"
                                               FontSize="12" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Кнопки + / QUEST / – внизу среднего поля -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Style="{StaticResource HoverButton}"
                        Text="+" FontSize="34" FontAttributes="Bold"
                        TextColor="#4CAF50"
                        BackgroundColor="White"
                        BorderColor="#30000000" BorderWidth="1"
                        WidthRequest="76" HeightRequest="62" CornerRadius="14"
                        Command="{Binding AddCommand}" />
                <Button Grid.Column="2"
                        Style="{StaticResource HoverButton}"
                        Text="QUEST" FontSize="18" FontAttributes="Bold"
                        TextColor="#F5A623"
                        BackgroundColor="White"
                        BorderColor="#30000000" BorderWidth="1"
                        HeightRequest="62" CornerRadius="14" Padding="10,0"
                        Command="{Binding GoHomeCommand}" />
                <Button Grid.Column="4"
                        Style="{StaticResource HoverButton}"
                        Text="–" FontSize="34" FontAttributes="Bold"
                        TextColor="#E53935"
                        BackgroundColor="White"
                        BorderColor="#30000000" BorderWidth="1"
                        WidthRequest="76" HeightRequest="62" CornerRadius="14"
                        Command="{Binding RemoveCommand}" />
            </Grid>
        </Grid>

        <!-- НИЖНИЙ БЛОК: лента наслаивающихся вкладок листов -->
        <Grid Grid.Row="2" HeightRequest="108" BackgroundColor="#F7F7F7">
            <BoxView HeightRequest="1" Color="#30000000" VerticalOptions="Start" />
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Always"
                        Padding="20,14">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tabs}"
                                       Spacing="0" VerticalOptions="Fill">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestTab">
                            <Border StrokeShape="RoundRectangle 12,12,0,0"
                                    StrokeThickness="1" Stroke="#40000000"
                                    BackgroundColor="{Binding ColorHex}"
                                    WidthRequest="120"
                                    Margin="-14,0,0,0"
                                    Padding="10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TranslationY" Value="-8" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenTabCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       TextColor="#222222"
                                       FontSize="14" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
