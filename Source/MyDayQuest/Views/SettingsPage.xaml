<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyDayQuest.Views.SettingsPage"
             BackgroundColor="{StaticResource Leather}"
             Title="Настройки">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ============ Напоминание ============ -->
            <Border StrokeShape="RoundRectangle 8" StrokeThickness="2"
                    Stroke="{StaticResource QuestGold}"
                    BackgroundColor="{StaticResource Parchment}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Напоминание" TextColor="{StaticResource QuestInk}"
                           FontAttributes="Bold" FontSize="18" />
                    <Label TextColor="{StaticResource QuestInk}" LineHeight="1.35"
                           Text="Раз в день приложение напомнит, какие задания стоят в Главном Листе. Невыполненные со вчера будут отмечены отдельно." />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Напоминать о заданиях"
                               TextColor="{StaticResource QuestInk}"
                               FontSize="16" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="ReminderSwitch"
                                OnColor="{StaticResource QuestSelect}"
                                ThumbColor="{StaticResource Parchment}"
                                Toggled="OnReminderToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                          x:Name="TimeRow" IsVisible="False">
                        <Label Grid.Column="0" Text="Во сколько"
                               TextColor="{StaticResource QuestInk}"
                               FontSize="16" VerticalOptions="Center" />
                        <TimePicker Grid.Column="1" x:Name="ReminderTime"
                                    Format="HH:mm"
                                    TextColor="{StaticResource QuestInk}"
                                    PropertyChanged="OnTimeChanged" />
                    </Grid>

                    <Label x:Name="ReminderNote" IsVisible="False"
                           TextColor="{StaticResource QuestInkSoft}" FontSize="13"
                           LineHeight="1.3"
                           Text="После перезагрузки телефона напоминание включится снова, когда вы откроете приложение." />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
