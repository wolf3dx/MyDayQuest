<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyDayQuest.ViewModels"
             x:Class="MyDayQuest.Views.TaskDetailPage"
             x:DataType="vm:TaskDetailViewModel"
             Title="Задание">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12"
          BackgroundColor="{DynamicResource Leather}">

        <!-- Верхний блок: NAME, Data Start, Data Ded Line, Progres -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Border StrokeShape="RoundRectangle 8" StrokeThickness="2"
                    Stroke="{DynamicResource QuestGold}"
                    BackgroundColor="{DynamicResource Parchment}" Padding="14,10">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Label Text="NAME:" TextColor="{DynamicResource QuestInk}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding TaskName}" Placeholder="Название задания" TextColor="{DynamicResource QuestInk}" />
                    </Grid>

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Label Text="Data Start:" TextColor="{DynamicResource QuestInk}" FontAttributes="Bold" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding StartDate}" Format="dd.MM.yy" HorizontalOptions="Start" />
                    </Grid>

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Label Text="Data Ded Line:" TextColor="{DynamicResource QuestInk}" FontAttributes="Bold" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding Deadline}" Format="dd.MM.yy" HorizontalOptions="Start" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsRepeating}"
                                  Color="{DynamicResource QuestInk}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Повторять каждый день"
                                   TextColor="{DynamicResource QuestInk}" FontAttributes="Bold" />
                            <Label Text="О задании будут напоминать ежедневно, пока оно не выполнено."
                                   TextColor="{DynamicResource QuestInkSoft}" FontSize="12" LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <Label Text="Progres:" TextColor="{DynamicResource QuestInk}" FontAttributes="Bold" VerticalOptions="Center" />
                        <ProgressBar Grid.Column="1" ProgressColor="{DynamicResource QuestGold}"
                                     Progress="{Binding Progress, Converter={StaticResource PercentToFraction}}"
                                     VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding ProgressPercentText}" TextColor="{DynamicResource QuestInk}" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Подзадания -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Subtasks}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Цели задания не заданы. Добавьте их кнопкой «+»."
                       TextColor="{DynamicResource QuestGoldBright}" Opacity="0.5" Padding="8,16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubtaskVM">
                    <Border StrokeShape="RoundRectangle 6" StrokeThickness="2"
                            BackgroundColor="{DynamicResource Parchment}" Padding="8" Margin="0,0,0,6">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource QuestSelect}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                <Setter Property="Stroke" Value="{DynamicResource ParchmentEdge}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskDetailViewModel}}, Path=SelectSubtaskCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Row="0" Grid.Column="0"
                                      IsChecked="{Binding IsDone}"
                                      VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Title}" Placeholder="Цель задания"
                                   TextColor="{DynamicResource QuestInk}"
                                   VerticalOptions="Center" />

                            <!-- Срок: без галочки дата не учитывается, иначе DatePicker
                                 сделал бы срочным каждое подзадание. -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <CheckBox IsChecked="{Binding HasDue}"
                                          Color="{DynamicResource QuestInk}" VerticalOptions="Center" />
                                <Label Text="к дате" TextColor="{DynamicResource QuestInkSoft}"
                                       FontSize="13" VerticalOptions="Center" />
                                <DatePicker Date="{Binding DueDate}" Format="dd.MM.yy"
                                            IsVisible="{Binding HasDue}"
                                            TextColor="{DynamicResource QuestInk}"
                                            VerticalOptions="Center" />
                                <Label Text="срок прошёл" IsVisible="{Binding IsMissed}"
                                       TextColor="{DynamicResource QuestRed}"
                                       FontAttributes="Bold" FontSize="12"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- + / – для подзаданий и сохранение -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="+" FontSize="26" FontAttributes="Bold"
                        TextColor="{DynamicResource QuestGreen}"
                        BackgroundColor="{DynamicResource LeatherButton}"
                        BorderColor="{DynamicResource QuestGold}" BorderWidth="1"
                        WidthRequest="70" HeightRequest="54" CornerRadius="6"
                        Command="{Binding AddSubtaskCommand}" />
                <Button Grid.Column="2" Text="–" FontSize="26" FontAttributes="Bold"
                        TextColor="{DynamicResource QuestRed}"
                        BackgroundColor="{DynamicResource LeatherButton}"
                        BorderColor="{DynamicResource QuestGold}" BorderWidth="1"
                        WidthRequest="70" HeightRequest="54" CornerRadius="6"
                        Command="{Binding RemoveSubtaskCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Отмена"
                        TextColor="{DynamicResource QuestGoldBright}"
                        BackgroundColor="{DynamicResource LeatherButton}"
                        BorderColor="{DynamicResource QuestGold}" BorderWidth="1" CornerRadius="6"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Принять"
                        TextColor="{DynamicResource QuestGoldBright}"
                        BackgroundColor="{DynamicResource LeatherButton}"
                        BorderColor="{DynamicResource QuestGold}" BorderWidth="1" CornerRadius="6"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
