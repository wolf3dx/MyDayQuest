<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyDayQuest.ViewModels"
             x:Class="MyDayQuest.Views.TaskDetailPage"
             x:DataType="vm:TaskDetailViewModel"
             Title="Задание">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Верхний блок: NAME, Data Start, Data Ded Line, Progres -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Border StrokeShape="RoundRectangle 14" StrokeThickness="1.5" Stroke="#50000000" Padding="14,10">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Label Text="NAME:" FontAttributes="Bold" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding TaskName}" Placeholder="Название задания" />
                    </Grid>

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Label Text="Data Start:" FontAttributes="Bold" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding StartDate}" Format="dd.MM.yy" HorizontalOptions="Start" />
                    </Grid>

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <Label Text="Data Ded Line:" FontAttributes="Bold" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding Deadline}" Format="dd.MM.yy" HorizontalOptions="Start" />
                    </Grid>

                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <Label Text="Progres:" FontAttributes="Bold" VerticalOptions="Center" />
                        <ProgressBar Grid.Column="1"
                                     Progress="{Binding Progress, Converter={StaticResource PercentToFraction}}"
                                     VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding ProgressPercentText}" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Подзадания -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Subtasks}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Подзаданий нет. Добавьте строкой «+»." Opacity="0.45" Padding="8,16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubtaskVM">
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="2" Padding="8" Margin="0,0,0,6">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                <Setter Property="Stroke" Value="#30808080" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskDetailViewModel}}, Path=SelectSubtaskCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsDone}"
                                      VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Title}" Placeholder="Подзадание"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- + / – для подзаданий и сохранение -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="+" FontSize="26" FontAttributes="Bold"
                        TextColor="#4CAF50" BackgroundColor="White"
                        BorderColor="#30000000" BorderWidth="1"
                        WidthRequest="70" HeightRequest="54" CornerRadius="12"
                        Command="{Binding AddSubtaskCommand}" />
                <Button Grid.Column="2" Text="–" FontSize="26" FontAttributes="Bold"
                        TextColor="#E53935" BackgroundColor="White"
                        BorderColor="#30000000" BorderWidth="1"
                        WidthRequest="70" HeightRequest="54" CornerRadius="12"
                        Command="{Binding RemoveSubtaskCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Отмена" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Сохранить" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
